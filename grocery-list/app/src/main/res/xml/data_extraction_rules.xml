<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keeps the Claude API key and Facebook sign-in out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="claude_settings.xml" />
        <!-- The Facebook sign-in from the in-app reel viewer. -->
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="claude_settings.xml" />
        <!-- The Facebook sign-in from the in-app reel viewer. -->
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
