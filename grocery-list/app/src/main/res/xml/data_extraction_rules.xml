<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Keeps the Claude API key out of cloud backups and device-to-device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="claude_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="claude_settings.xml" />
    </device-transfer>
</data-extraction-rules>
